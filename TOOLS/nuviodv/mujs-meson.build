# Minimal static library integration, following Meson WrapDB's MuJS integration.
# MuJS itself is fetched at the source lock's exact commit (ISC license).
project('mujs', 'c', version: '1.3.8', license: 'ISC')
cc = meson.get_compiler('c')
mujs_library = static_library('mujs', 'one.c',
    dependencies: cc.find_library('m', required: false),
    override_options: ['c_std=c99'])
meson.override_dependency('mujs', declare_dependency(
    include_directories: include_directories('.'), link_with: mujs_library))
